---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredWork } from '../data/works';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout>
  <a class="skip-link" href="#main">本文へ移動</a>
  <main id="main">
    <section class="hero shell" aria-labelledby="site-title">
      <p class="eyebrow">Literary works</p>
      <h1 id="site-title">おかもとたいち<br />文学作品</h1>
      <p class="hero-copy">
        小説や随筆など、これまでに書いた文学作品と、その関連コンテンツをまとめています。
      </p>
    </section>

    <section class="section shell" aria-labelledby="featured-heading">
      <h2 id="featured-heading">代表作品</h2>
      <article class="featured-work">
        <div class="cover-stage">
          <img
            src={asset(featuredWork.cover)}
            alt={featuredWork.coverAlt}
            width="1063"
            height="1505"
            loading="eager"
          />
        </div>
        <div class="work-copy">
          <h3>{featuredWork.title}</h3>
          <p class="tagline">{featuredWork.tagline}</p>
          <p class="author">{featuredWork.author}</p>
          <div class="description">
            {featuredWork.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <p class="availability">{featuredWork.availability}</p>
        </div>
      </article>
    </section>

    <section class="section trailer-section shell" aria-labelledby="trailer-heading">
      <h2 id="trailer-heading">『八秒先の死角』予告編</h2>
      <div class="trailer-frame">
        <video
          controls
          playsinline
          preload="metadata"
          poster={asset('images/8seconds-trailer-poster.webp')}
          aria-label="短編小説『八秒先の死角』予告編"
        >
          <source src={asset('video/8seconds-trailer.mp4')} type="video/mp4" />
          お使いのブラウザでは動画を再生できません。
          <a href={asset('video/8seconds-trailer.mp4')}>予告編を開く</a>
        </video>
      </div>
    </section>

    <section class="section quiet-section shell" aria-labelledby="other-heading">
      <h2 id="other-heading">その他の作品</h2>
      <p class="muted-copy">現在、準備中です。</p>
    </section>

    <section class="section profile shell" aria-labelledby="profile-heading">
      <h2 id="profile-heading">おかもとたいち</h2>
      <div class="profile-copy">
        <p>静岡県浜松市出身。本業はエンジニアで、趣味として小説や随筆を書いています。</p>
        <p>日常の中で感じたことや、人との距離、考え方の変化などを題材に文章を書くことがあります。</p>
        <p>趣味のポーカーを題材にした短編小説『八秒先の死角』をはじめ、思いついたテーマを少しずつ作品にしています。</p>
      </div>
      <a class="text-link" href="https://taichi-okamoto.github.io/portfolio/">
        エンジニアとしての活動はこちら <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <footer class="site-footer shell">
    <p>© おかもとたいち</p>
    <nav aria-label="関連リンク">
      <a href="https://github.com/taichi-okamoto">GitHub</a>
      <a href="https://taichi-okamoto.github.io/portfolio/">エンジニアHP</a>
    </nav>
  </footer>
</BaseLayout>
